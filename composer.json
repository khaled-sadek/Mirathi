{
    "name": "khaled-sadek/mirathi",
    "description": "Mirathi - Share the inheritance and make it easy to distribute the inheritance among heirs",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "laravel",
        "framework",
        "nativephp",
        "mobile"
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "nativephp/mobile": "^3.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "ergebnis/composer-normalize": "^2.52",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0"
    },
    "repositories": [
        {
            "name": "nativephp-plugins",
            "type": "composer",
            "url": "https://plugins.nativephp.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan native:install"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": "pint --parallel",
        "mutate": [
            "Composer\\Config::disableProcessTimeout",
            "pest --parallel --mutate --covered-only"
        ],
        "refactor": "rector",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@test:refactor",
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "test:lint": "pint --parallel --test",
        "test:refactor": "rector --dry-run",
        "test:type-coverage": "pest --type-coverage --compact --coverage --min=100",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --parallel --colors=always --coverage --min=100"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
